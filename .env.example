# Browser app configuration.
# Only values prefixed with VITE_ are exposed to browser code.
VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:8787
VITE_ENABLE_MSW=false
VITE_TURNSTILE_SITE_KEY=replace-after-tofu-apply

# OpenTofu Cloudflare variables. Never commit real values.
TF_VAR_cloudflare_app_api_token=replace-with-pages-and-d1-token
TF_VAR_cloudflare_dns_api_token=replace-with-dns-token
TF_VAR_cloudflare_app_account_id=replace-with-splitwiser-app-account-id
TF_VAR_cloudflare_zone_id=replace-with-splitwiser-zone-id

# GitLab OpenTofu HTTP state variables.
TF_HTTP_ADDRESS=https://gitlab.com/api/v4/projects/replace-with-gitlab-project-id/terraform/state/splitwiser-production
TF_HTTP_LOCK_ADDRESS=https://gitlab.com/api/v4/projects/replace-with-gitlab-project-id/terraform/state/splitwiser-production/lock
TF_HTTP_UNLOCK_ADDRESS=https://gitlab.com/api/v4/projects/replace-with-gitlab-project-id/terraform/state/splitwiser-production/lock
TF_HTTP_USERNAME=replace-with-gitlab-username
TF_HTTP_PASSWORD=replace-with-gitlab-api-token
TF_HTTP_LOCK_METHOD=POST
TF_HTTP_UNLOCK_METHOD=DELETE
TF_HTTP_RETRY_WAIT_MIN=5

# OpenTofu input values.
TF_VAR_root_domain=splitwiser.app
TF_VAR_dashboard_domain=dash.splitwiser.app
TF_VAR_dashboard_subdomain=dash
TF_VAR_dashboard_project_name=splitwiser-dashboard-production
TF_VAR_d1_database_name=splitwiser-d1-production
TF_VAR_create_landing_project=false

# Worker-only local secrets belong in workers/api/.dev.vars.
