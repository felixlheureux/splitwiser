{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "splitwiser-api-production",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "head_sampling_rate": 1,
    },
  },
  "vars": {
    "API_ORIGIN": "https://api.splitwiser.app",
    "APP_ORIGIN": "https://dash.splitwiser.app",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitwiser-d1-production",
      "database_id": "replace-with-cloudflare-d1-database-id",
    },
  ],
}
