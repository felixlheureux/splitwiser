{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "splitwiser-api-production",
  "account_id": "451182ca7dd1755c7890284c1f7207f4",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "head_sampling_rate": 1,
    },
  },
  "vars": {
    "API_ORIGIN": "https://dash.splitwiser.app",
    "APP_ORIGIN": "https://dash.splitwiser.app",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitwiser-d1-production",
      "database_id": "bd7e70cc-9474-4a04-81b5-fc7bc54bab39",
    },
  ],
}
